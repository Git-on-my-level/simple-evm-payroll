# Private key of the sender wallet (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URL for the network (e.g., Ethereum mainnet, Polygon, etc.)
RPC_URL=https://rpc.frax.com

# dUSD token contract address
DUSD_CONTRACT_ADDRESS=0x788D96f655735f52c676A133f4dFC53cEC614d4A

# sdUSD ERC4626 vault. Defaults to this address in the script if unset.
# SDUSD_CONTRACT_ADDRESS=0x58AcC2600835211Dcb5847c5Fa422791Fd492409

# Network chain ID for Fraxtal
CHAIN_ID=252

# Block explorer URL for transaction links
EXPLORER_URL=https://fraxscan.com/tx/

# Gas price settings (optional, will use network defaults if not set)
# MAX_FEE_PER_GAS_GWEI=20
# MAX_PRIORITY_FEE_PER_GAS_GWEI=2
