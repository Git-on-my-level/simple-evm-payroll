# Private key of the sender wallet. The "0x" prefix is optional.
# WARNING: this key can move funds. Never commit your real .env file.
PRIVATE_KEY=your_private_key_here

# JSON-RPC endpoint for the target network.
RPC_URL=https://your-rpc-endpoint.example

# Address of the ERC20 token to distribute. Input amounts are denominated in
# this token. (When VAULT_ADDRESS is set, this must be the vault's underlying
# asset.)
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional ERC4626 vault address. If set, you can choose to pay in vault shares
# instead of the asset; the script converts input amounts to shares via
# previewDeposit and verifies vault.asset() matches TOKEN_ADDRESS.
# VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Expected chain ID (required). The script aborts if the RPC is connected to a
# different network, preventing payroll on the wrong chain. To bypass this check
# set ALLOW_ANY_CHAIN=1 (not recommended).
CHAIN_ID=1

# Optional block explorer transaction URL prefix used to print links.
# EXPLORER_URL=https://etherscan.io/tx/

# Optional EIP-1559 gas overrides (in gwei). Network defaults are used if unset.
# MAX_FEE_PER_GAS_GWEI=20
# MAX_PRIORITY_FEE_PER_GAS_GWEI=2

# Optional: force a dry run (no transactions sent) without the --dry-run flag.
# DRY_RUN=1
